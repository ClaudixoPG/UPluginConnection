  dialogueID: vg_quest_credential
  dialogues:
  - message: "Ya po %username%, antes que sigamos\u2026 \xBFten\xEDs tu credencial
      encima?"
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
    dalogueOptions:
    - message: "A\xFAn no he ido a buscarla"
  - message: "En ese caso, vamos a la Escuela de Videojuegos, ah\xED deben tener
      una copia"
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
    dalogueOptions:
    - message: Entiendo
  - message: "Sin la credencial no podr\xE1s seguir..."
