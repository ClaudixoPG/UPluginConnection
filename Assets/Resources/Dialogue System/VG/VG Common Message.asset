  dialogues:
  - message: Hola %username%
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
    dalogueOptions: []
  - message: Ando un poco estresado ahora...
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
    dalogueOptions: []
  - message: No he estudiado para ningun parcial y no se cual deberia priorizar
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
    dalogueOptions: []
  - message: "\xBFCual asignatura crees que deba concentrarme?"
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
    dalogueOptions:
    - message: Bases de datos
    - message: "Dise\xF1o 2D"
    - message: Orientado a objetos
  - message: Esperaba que no digas esa... Pero esta bien tomare tu consejo
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
