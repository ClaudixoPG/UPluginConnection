MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45d8770642537b941828e5dce62b031d, type: 3}
  m_Name: Rueda Quest End
  m_EditorClassIdentifier: 
  dialogueID: rueda_quest_end
  dialogues:
  - message: "\xA1Gran trabajo!"
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions: []
  - message: "\xBFSeguro que revisaste bien? "
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions: []
  - message: Puede parecer poca cosa, pero un error podria causar un gran impacto
      en el futuro de estas personas
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions:
    - message: Si
    - message: Tuve mucho cuidado
  - message: "Bien, de nuevo muchas gracias %username%, \xBFMe podrias hacer un peque\xF1o
      favor mas?"
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions: []
  - message: Puedes llevar las cajas de preservativos a la escuela, debo seguir atendiendo
      a las personas aqui.
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions:
    - message: No hay problema
    - message: Claro
    - message: Si
  - message: Bakan, nos vemos!
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions: []
