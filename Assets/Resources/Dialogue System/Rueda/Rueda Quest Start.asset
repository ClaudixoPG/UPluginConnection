%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45d8770642537b941828e5dce62b031d, type: 3}
  m_Name: Rueda Quest Start
  m_EditorClassIdentifier: 
  dialogueID: rueda_quest_start
  dialogues:
  - message: Hola, estas aqui!
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions: []
  - message: "Estamos muy saturados atendiendo a todos aqui, \xBFNos podrias ayudar?"
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions:
    - message: Claro
    - message: "\xBFEn que puedo ayudar?"
  - message: Nos acaban de traer unas cajas de preservativos pero debemos verificar
      que esten en buen estado
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions: []
  - message: "Ya sabes, ver que la fecha de caducidad este correcta, que no esten
      da\xF1adas, ese tipo de cuestiones"
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions: []
  - message: "No queremos causar \"accidentes\" \xBFYa sabes?"
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions:
    - message: Por su puesto que no
    - message: Seria terrible
    - message: Dejamelo a mi
  - message: Bakan, muchas gracias %username%
    background: {fileID: 21300000, guid: 7608e433f871d9443b63d1eec87f962b, type: 3}
    character: {fileID: 21300000, guid: f0e786c7774ecfa419709a910674eab0, type: 3}
    dalogueOptions: []
