  dialogueID: vg_quest_credential_end
  dialogues:
  - message: Wena ya tienes tu credencial
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
    dalogueOptions: []
  - message: "Oye creo que Camila necesita ayuda en la rueda, \xBFTe molestaria ir
      para alla y ayudarla?"
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
    dalogueOptions:
    - message: No hay problema
  - message: Muchas gracias, yo ahora estoy muy ocupado estudiando para los parciales
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
    dalogueOptions: []
  - message: Me comentas como te va, nos vemos %username%
    background: {fileID: 21300000, guid: 339e085cd71f0df4f8362be5afcb2ac1, type: 3}
    character: {fileID: 21300000, guid: 41ba3c2de86b31b448f485492e2d20cb, type: 3}
